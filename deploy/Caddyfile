{
	auto_https off
	# IP clients may omit SNI; select the public IP certificate behind Docker/NAT.
	default_sni {$PUBLIC_IP}
}

http://{$PUBLIC_IP} {
	handle /.well-known/acme-challenge/* {
		root * /var/www/certbot
		file_server
	}
	handle {
		redir https://{$PUBLIC_IP}{uri} 308
	}
}

https://{$PUBLIC_IP} {
	tls /etc/letsencrypt/live/zai/fullchain.pem /etc/letsencrypt/live/zai/privkey.pem
	header X-Content-Type-Options nosniff
	reverse_proxy api:8000
}
